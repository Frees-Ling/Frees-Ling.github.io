{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev *)",
      "Bash(npm run build *)",
      "Bash(npm run preview *)",
      "Bash(npm run check *)",
      "Bash(npm run lint *)",
      "Bash(npm run lint:fix *)",
      "Bash(npm run lint:md *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(astro dev *)",
      "Bash(astro check *)",
      "Bash(astro build *)",
      "Bash(astro preview *)"
    ],
    "ask": ["Bash(git push *)"],
    "deny": ["Edit(/archives/**)", "Edit(/public/history/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-commit.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
