<div class="sound-lab">
  <div class="sound-cover" aria-hidden="true"><span class="pulse p1"></span><span class="pulse p2"></span><span class="pulse p3"></span><b>F</b></div>
  <div class="sound-info"><p class="sound-kicker">GENERATIVE AMBIENT · LIVE</p><h2>风经过数字海</h2><p>一段在浏览器里实时生成的氛围声音。每次播放，波形都会有一点不同。</p><div class="controls"><button class="play" type="button" aria-pressed="false"><span>▶</span><b>开始试听</b></button><label>音量 <input class="volume" type="range" min="0" max="100" value="42" /></label></div><div class="wave" aria-hidden="true">{Array.from({length:42},(_,index)=><i style={`--h:${18 + ((index * 37) % 62)}%`}></i>)}</div><p class="timer"><span class="elapsed">00:00</span><span>GENERATIVE LOOP</span></p></div>
</div>
<script>
  const root=document.querySelector<HTMLElement>('.sound-lab');const button=root?.querySelector<HTMLButtonElement>('.play');const volume=root?.querySelector<HTMLInputElement>('.volume');const elapsed=root?.querySelector<HTMLElement>('.elapsed');let context:AudioContext|undefined;let master:GainNode|undefined;let oscillators:OscillatorNode[]=[];let timer:number|undefined;let started=0;
  const stop=()=>{if(master&&context){master.gain.cancelScheduledValues(context.currentTime);master.gain.setTargetAtTime(0,context.currentTime,.35)}oscillators.forEach((osc)=>{try{osc.stop(context!.currentTime+1)}catch{}});oscillators=[];if(timer)clearInterval(timer);button?.setAttribute('aria-pressed','false');if(button){button.querySelector('span')!.textContent='▶';button.querySelector('b')!.textContent='开始试听'}root?.classList.remove('playing')};
  const play=async()=>{context=new AudioContext();await context.resume();master=context.createGain();master.gain.value=0;master.connect(context.destination);master.gain.linearRampToValueAtTime((Number(volume?.value||42)/100)*.14,context.currentTime+2);const chord=[110,164.81,220,277.18];oscillators=chord.map((frequency,index)=>{const osc=context!.createOscillator();const gain=context!.createGain();const filter=context!.createBiquadFilter();osc.type=index%2?'sine':'triangle';osc.frequency.value=frequency*(.997+Math.random()*.006);gain.gain.value=.32/(index+1);filter.type='lowpass';filter.frequency.value=520+index*130;osc.connect(filter).connect(gain).connect(master!);osc.start();return osc});started=Date.now();timer=window.setInterval(()=>{const seconds=Math.floor((Date.now()-started)/1000);if(elapsed)elapsed.textContent=`${String(Math.floor(seconds/60)).padStart(2,'0')}:${String(seconds%60).padStart(2,'0')}`},1000);button?.setAttribute('aria-pressed','true');if(button){button.querySelector('span')!.textContent='Ⅱ';button.querySelector('b')!.textContent='暂停'}root?.classList.add('playing')};
  button?.addEventListener('click',()=>button.getAttribute('aria-pressed')==='true'?stop():play());volume?.addEventListener('input',()=>{if(master&&context)master.gain.setTargetAtTime((Number(volume.value)/100)*.14,context.currentTime,.08)});addEventListener('pagehide',stop);
</script>
<style>
  .sound-lab{display:grid;grid-template-columns:minmax(280px,.8fr) 1.2fr;gap:clamp(30px,7vw,90px);align-items:center;padding:clamp(28px,5vw,60px);border:1px solid var(--line);border-radius:32px;background:var(--surface);box-shadow:var(--shadow)}.sound-cover{position:relative;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f8a789,#9c5c83 34%,#123f4b 65%,#07171d);overflow:hidden;box-shadow:0 28px 70px rgba(0,0,0,.35)}.sound-cover::after{position:absolute;inset:8%;border:1px solid rgba(255,255,255,.25);border-radius:50%;content:''}.sound-cover b{z-index:2;color:#fff;font-family:Georgia,serif;font-size:clamp(64px,10vw,130px);font-weight:400}.pulse{position:absolute;border:1px solid rgba(255,255,255,.26);border-radius:50%}.p1{inset:18%}.p2{inset:30%}.p3{inset:42%}.playing .pulse{animation:pulse 3s ease-in-out infinite}.playing .p2{animation-delay:.6s}.playing .p3{animation-delay:1.2s}@keyframes pulse{50%{transform:scale(1.16);opacity:.25}}.sound-kicker{margin:0 0 12px;color:var(--cyan);font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.12em}.sound-info h2{margin:0;font-family:Georgia,"Songti SC",serif;font-size:clamp(38px,6vw,68px);font-weight:500;line-height:1.1}.sound-info>p:not(.sound-kicker,.timer){max-width:550px;color:var(--ink-soft)}.controls{display:flex;flex-wrap:wrap;align-items:center;gap:24px;margin:30px 0}.play{display:flex;align-items:center;gap:11px;padding:12px 18px;border:0;border-radius:999px;background:var(--coral);color:#201713;cursor:pointer}.play span{font-size:15px}.controls label{display:flex;align-items:center;gap:10px;color:var(--ink-faint);font-size:11px}.volume{width:100px;accent-color:var(--cyan)}.wave{height:64px;display:flex;align-items:center;gap:3px}.wave i{width:3px;height:var(--h);border-radius:3px;background:var(--ink-faint);transition:height .2s}.playing .wave i{animation:wave 1.2s ease-in-out infinite alternate}.playing .wave i:nth-child(3n){animation-delay:.3s}.playing .wave i:nth-child(4n){animation-delay:.6s}@keyframes wave{to{height:calc(var(--h)*.35);background:var(--cyan)}}.timer{display:flex;justify-content:space-between;margin:8px 0 0;color:var(--ink-faint);font-family:ui-monospace,monospace;font-size:10px;letter-spacing:.08em}@media(max-width:900px){.sound-lab{grid-template-columns:1fr}.sound-cover{width:min(100%,360px);margin:auto}}
</style>
