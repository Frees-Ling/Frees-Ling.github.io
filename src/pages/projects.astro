---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/site';
---
<Layout title="项目" description="Frees Ling 正在构建和研究的项目。"><header class="page-hero container"><p class="eyebrow">PROJECTS · BUILDING IN PUBLIC</p><h1 class="page-title">把好奇心，<br />做成可以运行的东西。</h1><p class="lede">这些项目不一定已经完成，但都诚实地记录了问题、选择和下一步。</p></header><section class="container projects">{projects.map((project,index)=><article class={`project ${project.accent}`}><div class="project-head"><span>0{index+1}</span><p>{project.type} · {project.year}</p><em>{project.status}</em></div><h2>{project.name}</h2><p class="description">{project.description}</p><ul class="tag-list">{project.tags.map((tag)=><li class="tag">{tag}</li>)}</ul></article>)}</section><section class="section container timeline"><div><p class="eyebrow">TIMELINE</p><h2 class="section-title">一条仍在延伸的线</h2></div><ol><li><time>2025</time><div><h3>开始认真记录</h3><p>建立博客，整理 AI、本地部署与开发学习笔记。</p></div></li><li><time>2026 · H1</time><div><h3>从学习走向构建</h3><p>围绕计算机视觉、机器人和项目开发形成连续记录。</p></div></li><li><time>2026 · H2</time><div><h3>研究与创作并行</h3><p>深入麻将 AI、Transformer，同时开始整理音乐与角色创作。</p></div></li><li class="future"><time>NEXT</time><div><h3>保持开放</h3><p>下一段旅程还没有名字。</p></div></li></ol></section></Layout>
<style>.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;padding-bottom:100px}.project{min-height:390px;display:flex;flex-direction:column;padding:34px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}.project-head{display:flex;align-items:center;gap:14px;color:var(--ink-faint);font-family:ui-monospace,monospace;font-size:10px}.project-head p{flex:1;margin:0}.project-head em{padding:4px 9px;border:1px solid var(--line);border-radius:999px;font-style:normal}.project h2{margin:auto 0 18px;font-family:Georgia,"Songti SC",serif;font-size:clamp(36px,5vw,60px);font-weight:500;line-height:1}.project.cyan h2{color:var(--cyan)}.project.coral h2{color:var(--coral)}.project.violet h2{color:var(--violet)}.project.lime h2{color:var(--lime)}.description{max-width:520px;color:var(--ink-soft)}.timeline{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;border-top:1px solid var(--line)}.timeline ol{margin:0;padding:0;list-style:none}.timeline li{display:grid;grid-template-columns:100px 1fr;gap:24px;padding:24px 0;border-bottom:1px solid var(--line)}.timeline time{color:var(--ink-faint);font-family:ui-monospace,monospace;font-size:11px}.timeline h3{margin:0;font-family:Georgia,"Songti SC",serif;font-size:24px;font-weight:500}.timeline p{margin:5px 0 0;color:var(--ink-soft)}.timeline .future{opacity:.55}@media(max-width:760px){.projects{grid-template-columns:1fr}.timeline{grid-template-columns:1fr}.project{min-height:330px}}</style>
