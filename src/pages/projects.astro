---
import Layout from '../layouts/Layout.astro';
import { projects, articleTitles } from '../data/site';
---
<Layout title="项目" description="凛风正在做的几件事，以及它们留下的真实记录。"><header class="page-hero container"><p class="eyebrow">项目</p><h1 class="page-title">做过的，<br />和还没做完的。</h1><p class="lede">这里不是成果陈列。每个项目下面链到的是它真实留下的记录 —— 有文章就链文章，还没有就照实说没有。</p></header><section class="container projects">{projects.map((project,index)=><article class="project"><div class="project-head"><span>0{index+1}</span><p>{project.type} · {project.year}</p><em>{project.status}</em></div><h2>{project.name}</h2><p class="description">{project.description}</p><ul class="tag-list">{project.tags.map((tag)=><li class="tag">{tag}</li>)}</ul><div class="project-links">{project.articles.length > 0 ? (<ul class="project-articles">{project.articles.map((slug)=><li><a href={`/blog/${slug}/`}>{articleTitles[slug] ?? slug}</a></li>)}</ul>) : (<p class="project-empty">还没有写成文的工作记录。研究在继续，等有可复查的结论再放上来。</p>)}{project.repo ? (<a class="project-repo" href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={`在 GitHub 上查看 ${project.name} 的源代码仓库`}><span>{project.repoStatus}</span><span class="repo-url">{project.repo.replace('https://github.com/', '')}</span></a>) : (<p class="project-repo is-absent"><span>{project.repoStatus}</span><span class="repo-url">暂无公开仓库地址</span></p>)}</div></article>)}</section><section class="section container timeline"><div><p class="eyebrow">时间线</p><h2 class="section-title">一条仍在延伸的线</h2></div><ol><li><time>2025</time><div><h3>开始认真记录</h3><p>建立博客，整理 AI、本地部署与开发学习笔记。</p></div></li><li><time>2026 · H1</time><div><h3>从学习走向构建</h3><p>围绕计算机视觉、机器人和项目开发形成连续记录。</p></div></li><li><time>2026 · H2</time><div><h3>研究与创作并行</h3><p>深入麻将 AI、Transformer，同时开始整理音乐与角色创作。</p></div></li><li class="future"><time>接下来</time><div><h3>保持开放</h3><p>下一段旅程还没有名字。</p></div></li></ol></section></Layout>
<style>.projects{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;padding-bottom:100px}.project{min-height:390px;display:flex;flex-direction:column;padding:34px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}.project-head{display:flex;align-items:center;gap:14px;color: var(--ink-soft);font-family:var(--font-mono);font-size:10px}.project-head p{flex:1;margin:0}.project-head em{padding:4px 9px;border:1px solid var(--line);border-radius: var(--radius-sm);font-style:normal}.project h2{margin:auto 0 18px;font-family:var(--font-display);font-size:clamp(24px,2.8vw,34px);font-weight:500;line-height:1;color:var(--ink)}.description{max-width:520px;color:var(--ink-soft)}.project-links{margin-top:22px;padding-top:16px;border-top:1px solid var(--line)}.project-articles{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:7px}.project-articles a{color:var(--ink);text-decoration:none;border-bottom:1px solid transparent;transition:border-color 140ms ease}.project-articles a:hover{border-bottom-color:var(--signal-text);color:var(--signal-text)}.project-articles a::before{content:'→ ';color:var(--signal-text);font-family:var(--font-mono)}.project-empty{margin:0;color:var(--ink-soft);font-size:13px}.project-repo{display:flex;flex-direction:column;gap:3px;margin-top:14px;color:var(--ink);text-decoration:none}.project-repo span:first-child{font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;color:var(--signal-text)}.project-repo .repo-url{font-family:var(--font-mono);font-size:11px;color:var(--ink-soft);border-bottom:1px solid transparent}.project-repo:hover .repo-url{border-bottom-color:currentColor;color:var(--ink)}.project-repo.is-absent{color:var(--ink-soft)}.project-repo.is-absent span:first-child{color:var(--ink-soft)}@media(max-width:900px){.project{min-height:auto}}.timeline{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;border-top:1px solid var(--line)}.timeline ol{margin:0;padding:0;list-style:none}.timeline li{display:grid;grid-template-columns:100px 1fr;gap:24px;padding:24px 0;border-bottom:1px solid var(--line)}.timeline time{color: var(--ink-soft);font-family:var(--font-mono);font-size:11px}.timeline h3{margin:0;font-family:var(--font-display);font-size:18px;font-weight:500}.timeline p{margin:5px 0 0;color:var(--ink-soft)}.timeline .future{border-bottom-style:dashed}@media(max-width:900px){.projects{grid-template-columns:1fr}.timeline{grid-template-columns:1fr}.project{min-height:330px}}</style>
