---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { nowItems, projects, site } from '../data/site';
import { byNewest, formatDate } from '../utils/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byNewest);

// 首页分两层呈现文章，靠**信息密度**而非虚构分类区分：
//   Selected Writing —— 编辑式，带摘要，回答「这里有什么值得读的」
//   Recent Notes     —— 索引式，只有日期、编号与标题，像一本日志的目录
// 两者都直接来自内容集合，没有硬编码白名单（栏目数据化是 WEB-008 的范围）。
// 取 3 篇：第 1 篇在网格里 span 2 占满整行，后两篇各占一列 —— 正好填满。
// 取 2 篇会在右侧留下半格空白（第 1 篇整行 + 第 2 篇半列）。
const featured = posts.slice(0, 3);
const recent = posts.slice(3, 12);

const oldest = posts.at(-1);
const newest = posts.at(0);
const yearSpan =
  oldest && newest
    ? oldest.data.published.getFullYear() === newest.data.published.getFullYear()
      ? `${newest.data.published.getFullYear()}`
      : `${oldest.data.published.getFullYear()}–${newest.data.published.getFullYear()}`
    : '';
---

<Layout>
  <!-- ── IDENTITY ────────────────────────────────────────────────
       首屏必须在五秒内回答 Who / What / Why。
       旧的 hero 是站点名「Frees Blog.」加一个装饰圆环 —— 回答了「这个站叫什么」，
       但没有回答「这个人做什么、为什么值得继续看」。 -->
  <section class="identity">
    <div class="container identity-grid">
      <div class="identity-copy">
        <p class="identity-coord">
          <span>31.23° N · 121.47° E</span>
          <span>EST. 2025</span>
        </p>
        <h1 class="identity-name">{site.owner}<em>{site.alias}</em></h1>
        <p class="identity-what">
          记录 <strong>AI 决策</strong>、<strong>计算机视觉</strong>与<strong>机器人实验</strong>的工程观察笔记 ——
          麻将策略的评估方法、YOLO 训练与数据标注、Unitree Go2 的真实设备交互，
          以及把 Transformer 从线性代数重新推导一遍的长文。
        </p>
        <p class="identity-why">
          不是教程搬运，而是可复查的过程记录：{yearSpan} 年至今 {posts.length} 篇，
          包含推理过程、失败的尝试和当时的困惑。
        </p>
        <div class="identity-actions">
          <a class="button primary" href="/blog/">阅读记录</a>
          <a class="button" href="/about/">关于我</a>
        </div>
      </div>

      <dl class="identity-facts">
        <div><dt>RECORDING SINCE</dt><dd>2025</dd></div>
        <div><dt>ENTRIES</dt><dd>{posts.length}</dd></div>
        <div><dt>LAST LOGGED</dt><dd>{posts[0] ? formatDate(posts[0].data.published) : '—'}</dd></div>
        <div><dt>LONGEST</dt><dd>232K 字 · Transformer</dd></div>
      </dl>
    </div>
  </section>

  <!-- ── SELECTED WORK ───────────────────────────────────────────
       发丝线表格行，不用卡片。四个项目全部来自 site.ts 的真实数据。 -->
  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">SELECTED WORK</p>
          <h2 id="work-title" class="section-title">持续构建中</h2>
        </div>
        <a class="text-link" href="/projects/">完整项目时间线</a>
      </div>
      <ol class="work-list">
        {
          projects.map((project, index) => (
            <li class="work-row">
              <span class="work-no">{String(index + 1).padStart(2, '0')}</span>
              <div class="work-head">
                <p>
                  {project.type} · {project.year}
                </p>
                <h3>{project.name}</h3>
              </div>
              <p class="work-desc">{project.description}</p>
              <span class="work-state">{project.status}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── FEATURED WRITING ──────────────────────────────────────── -->
  <section class="section" aria-labelledby="writing-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">FEATURED WRITING</p>
          <h2 id="writing-title" class="section-title">最近写下的</h2>
        </div>
        <p>技术不是孤岛。这里同时保存过程、困惑，以及某个时刻真正想说的话。</p>
      </div>
      <div class="post-grid">
        {featured.map((post, index) => <PostCard post={post} featured={index === 0} />)}
      </div>
    </div>
  </section>

  <!-- ── RECENT NOTES ──────────────────────────────────────────────
       索引式呈现：只有编号、日期、标题与分类。
       与上面的编辑式卡片形成密度对比，像一本日志的目录页。 -->
  <section class="section" aria-labelledby="notes-title">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">RECENT NOTES</p>
          <h2 id="notes-title" class="section-title">更早的记录</h2>
        </div>
        <p>按时间倒序的全部条目，包含短文与实验片段。</p>
      </div>
      <ol class="index-list">
        {
          recent.map((post, index) => (
            <li>
              <a href={`/blog/${post.id.replace(/\.(md|mdx)$/i, '')}/`}>
                <span class="index-no">
                  {String(posts.length - index - 3).padStart(3, '0')}
                </span>
                <time datetime={post.data.published.toISOString()}>
                  {formatDate(post.data.published)}
                </time>
                <span class="index-title">{post.data.title}</span>
                <span class="index-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="index-more">
        <a class="text-link" href="/archive/">查看全部 {posts.length} 篇记录</a>
      </p>
    </div>
  </section>

  <!-- ── CURRENT SIGNAL ────────────────────────────────────────── -->
  <section class="section signal" aria-labelledby="signal-title">
    <div class="container signal-grid">
      <div>
        <p class="eyebrow">CURRENT SIGNAL</p>
        <h2 id="signal-title" class="section-title">此刻，<br />我正在……</h2>
        <a class="text-link" href="/now/">打开 Now 页面</a>
      </div>
      <dl class="signal-list">
        {
          nowItems.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 用户确认为真实的话，保留署名 -->
  <section class="quote">
    <div class="container">
      <blockquote>
        保持敏感，保持具体。<br />在这个世界里，留下属于自己的坐标。
      </blockquote>
      <cite>— Frees Ling</cite>
    </div>
  </section>
</Layout>

<style>
  /* ── IDENTITY ── */
  .identity {
    padding: clamp(64px, 9vw, 120px) 0 clamp(40px, 5vw, 72px);
  }
  .identity-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.55fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .identity-coord {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0 0 28px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .identity-name {
    margin: 0 0 26px;
    font-family: var(--font-display);
    font-size: clamp(52px, 8.5vw, 118px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.94;
  }
  .identity-name em {
    display: block;
    color: var(--signal-text);
    font-style: italic;
  }
  .identity-what {
    max-width: 60ch;
    margin: 0 0 18px;
    color: var(--ink);
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.65;
  }
  .identity-what strong {
    font-weight: 600;
  }
  .identity-why {
    max-width: 60ch;
    margin: 0 0 34px;
    color: var(--ink-soft);
  }
  .identity-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .identity-facts {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .identity-facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 18px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
  }
  .identity-facts dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
  }
  .identity-facts dd {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* ── SELECTED WORK ── */
  .work-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .work-row {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) minmax(0, 1.15fr) 96px;
    /* 用 start 而非 baseline：标题是 32px 衬线、其余是 13px 无衬线，
       baseline 对齐会把大字号标题整体压低，三列看起来错位。
       改为统一顶对齐，再用 padding-top 做光学微调。 */
    align-items: start;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .work-no,
  .work-state,
  .work-head p,
  .work-desc {
    padding-top: 6px;
  }
  .work-no {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .work-head p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 13px;
  }
  .work-head h3 {
    margin: 5px 0 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .work-desc {
    margin: 0;
    color: var(--ink-soft);
  }
  .work-state {
    justify-self: end;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  /* ── FEATURED WRITING ── */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  /* ── RECENT NOTES（索引式，与卡片形成密度对比）── */
  .index-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .index-list li {
    border-bottom: 1px solid var(--line);
  }
  .index-list a {
    display: grid;
    grid-template-columns: 48px 128px minmax(0, 1fr) 24px;
    align-items: baseline;
    gap: 20px;
    padding: 15px 0;
    color: inherit;
    text-decoration: none;
  }
  .index-no {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .index-list time {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .index-title {
    color: var(--ink);
    font-size: 16px;
  }
  .index-arrow {
    justify-self: end;
    color: var(--signal-text);
    transition: transform 140ms ease;
  }
  .index-list a:hover .index-arrow {
    transform: translate(3px, -3px);
  }
  .index-more {
    margin: 26px 0 0;
    text-align: right;
  }

  /* ── CURRENT SIGNAL ── */
  .signal {
    border-top: 1px solid var(--line);
  }
  .signal-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(40px, 8vw, 120px);
  }
  .signal-grid .text-link {
    margin-top: 30px;
  }
  .signal-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .signal-list > div {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .signal-list dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .signal-list dd {
    margin: 0;
    color: var(--ink);
    font-size: 17px;
  }

  /* ── QUOTE ── */
  .quote {
    padding: clamp(72px, 11vw, 150px) 0;
    border-top: 1px solid var(--line);
  }
  .quote blockquote {
    /* 不设 ch 宽度上限：ch 基于拉丁字形宽度，对中文过窄，
       会把「保持具体。」拆成两行。断行交给内容里的 <br /> 控制。 */
    margin: 0 0 26px;
    font-family: var(--font-display);
    font-size: clamp(30px, 5.4vw, 66px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  .quote cite {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    font-style: normal;
    letter-spacing: 0.14em;
  }

  /* ── 移动端：独立构图，不是桌面压缩 ── */
  @media (max-width: 900px) {
    .identity-grid,
    .signal-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .identity-facts {
      margin-top: 8px;
    }
    .work-row {
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 8px 16px;
      padding: 22px 0;
    }
    .work-head {
      grid-column: 2;
    }
    .work-desc,
    .work-state {
      grid-column: 2;
      justify-self: start;
    }
    .work-desc {
      margin-top: 4px;
    }
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .index-list a {
      grid-template-columns: 42px minmax(0, 1fr) 20px;
      gap: 8px 14px;
      align-items: start;
    }
    .index-list time {
      grid-row: 2;
      grid-column: 2;
    }
    .index-title {
      grid-column: 2;
    }
    .index-arrow {
      grid-row: 1 / span 2;
    }
    .signal-list > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .quote blockquote {
      max-width: none;
    }
  }
</style>
