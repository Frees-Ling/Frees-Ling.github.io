---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import banner from '../assets/banner.jpg';
import avatar from '../assets/avatar.jpg';

// 这两张图由 CSS 控制显示尺寸（object-fit: cover 撑满 figure），
// 所以 sizes 要按**实际渲染宽度**给，而不是拍拍脑袋写个 65vw。
// 容器上限 1180px、两列 1.3fr / .7fr、gap 20px → 754px 与 406px；
// 900px 以下变单列 → 100vw 减两侧留白。
const WIDE_SIZES = '(max-width: 900px) calc(100vw - 40px), 754px';
const TILE_SIZES = '(max-width: 900px) calc(100vw - 40px), 406px';
---
<Layout title="照片墙" description="Frees Ling 的视觉片段与生活切片。"><header class="page-hero container"><p class="eyebrow">影像片段</p><h1 class="page-title">被光留下的，<br />另一种笔记。</h1><p class="lede">第一辑从旧站保存下来的图像开始。未来的照片会继续填满这里。</p></header><section class="container gallery"><figure class="wide"><Image src={banner} alt="旧博客横幅中的天空与人物" widths={[480, 768, 1024, 1500]} sizes={WIDE_SIZES} loading="eager" fetchpriority="high" /><figcaption><span>01</span><p>旧站的天空</p><time>旧站</time></figcaption></figure><figure class="portrait"><Image src={avatar} alt="Frees Ling 的头像" widths={[240, 406, 812]} sizes={TILE_SIZES} /><figcaption><span>02</span><p>关于我</p><time>关于</time></figcaption></figure><figure class="crop"><Image src={banner} alt="旧博客横幅的局部光影" widths={[240, 406, 812]} sizes={TILE_SIZES} /><figcaption><span>03</span><p>光落下的位置</p><time>片段</time></figcaption></figure><div class="gallery-note"><span>未完待续</span><p>下一张照片，<br />也许就在明天。</p></div></section></Layout>
<style>.gallery{display:grid;grid-template-columns:1.3fr .7fr;gap:20px;padding-bottom:120px}.gallery figure{margin:0;overflow:hidden}.gallery img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}.gallery figure:hover img{transform:scale(1.025)}.wide{grid-row:span 2;min-height:700px}.portrait,.crop{height:340px}.portrait img{object-position:center}.crop img{object-position:72% center}.gallery figcaption{display:flex;gap:12px;align-items:center;margin-top:11px;color:var(--ink-soft);font-size:12px}.gallery figcaption span,.gallery figcaption time{font-family:var(--font-mono);font-size:9px;color: var(--ink-soft)}.gallery figcaption p{flex:1;margin:0}.gallery-note{grid-column:1/-1;display:flex;align-items:flex-end;justify-content:space-between;gap:30px;padding:60px 0 0;border-top:1px solid var(--line)}.gallery-note span{color:var(--signal-text);font-family:var(--font-mono);font-size:10px;letter-spacing:.12em}.gallery-note p{margin:0;font-family:var(--font-display);font-size:clamp(20px,2.4vw,28px);text-align:right}@media(max-width:900px){.gallery{grid-template-columns:1fr}.wide{min-height:480px}.gallery-note{align-items:flex-start;flex-direction:column}.gallery-note p{text-align:left}}</style>
