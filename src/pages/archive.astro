---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { getAllPosts } from '../utils/posts-query';

const posts = await getAllPosts();
---
<Layout title="文章归档" description="按年份回看的全部文章归档。">
  <header class="page-hero container">
    <p class="eyebrow">归档 · {posts.length} 篇</p>
    <h1 class="page-title">时间把文章<br />排列成另一种故事。</h1>
    <p class="lede">沿着年份回看，能看到兴趣怎样转弯，问题又怎样慢慢变得具体。</p>
  </header>
  <!-- 归档的契约是纯时间顺序：这里**不**按 substance 重排，
       短记录留在它本来的位置，只在行内标注 —— 打乱年份会让归档失去意义。 -->
  <section class="container archive">
    <PostList posts={posts} variant="row" groupBy="year" />
  </section>
</Layout>
<style>
  .archive {
    padding-bottom: 120px;
  }
</style>
