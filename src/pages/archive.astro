---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { byNewest, formatDate, normalizeCategory, postHref } from '../utils/posts';
const posts=(await getCollection('posts',({data})=>!data.draft)).sort(byNewest);
const years=Object.groupBy(posts,(post)=>String(post.data.published.getFullYear()));
---
<Layout title="文章归档"><header class="page-hero container"><p class="eyebrow">ARCHIVE · {posts.length} ENTRIES</p><h1 class="page-title">时间把文章<br />排列成另一种故事。</h1><p class="lede">沿着年份回看，能看到兴趣怎样转弯，问题又怎样慢慢变得具体。</p></header><section class="container archive">{Object.entries(years).sort(([a],[b])=>Number(b)-Number(a)).map(([year,items])=><div class="year"><h2>{year}</h2><div>{items?.map((post)=><a href={postHref(post)}><time>{formatDate(post.data.published).replace(`${year}年`,'')}</time><span>{post.data.title}</span><em>{normalizeCategory(post.data.category)}</em></a>)}</div></div>)}</section></Layout>
<style>.archive{padding-bottom:120px}.year{display:grid;grid-template-columns:160px 1fr;gap:40px;padding:42px 0;border-top:1px solid var(--line)}.year h2{position:sticky;top:24px;align-self:start;margin:0;color:var(--coral);font-family:Georgia,serif;font-size:50px;font-weight:500}.year a{display:grid;grid-template-columns:110px 1fr 80px;gap:20px;padding:18px 0;border-bottom:1px solid var(--line);text-decoration:none}.year a:hover span{color:var(--cyan)}.year time,.year em{color:var(--ink-faint);font-family:ui-monospace,monospace;font-size:11px;font-style:normal}.year span{font-family:Georgia,"Songti SC",serif;font-size:20px;transition:color 180ms}@media(max-width:900px){.year{grid-template-columns:1fr}.year h2{position:static}.year a{grid-template-columns:80px 1fr}.year em{display:none}}</style>
