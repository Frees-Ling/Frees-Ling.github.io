---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { normalizeCategory } from '../../utils/posts';
import { getAllPosts } from '../../utils/posts-query';

const posts = await getAllPosts();
const categories = [
  '全部',
  ...new Set(posts.map((post) => normalizeCategory(post.data.category))),
];
---
<Layout title="文章" description="Frees Ling 的技术文章、研究笔记与生活记录。">
  <header class="page-hero container">
    <p class="eyebrow">全部文章 · {posts.length} 篇</p>
    <h1 class="page-title">文章不是答案，<br />是思考留下的轨迹。</h1>
    <p class="lede">从 AI、计算机视觉和机器人，到生活里无法归类的片段。按时间阅读，也可以沿着标签漫游。</p>
  </header>
  <section class="container blog-section">
    <div class="filter-bar" role="group" aria-label="按分类筛选">
      {
        categories.map((category, index) => (
          <button type="button" class:list={{ active: index === 0 }} aria-pressed={index === 0} data-category={category}>
            {category}
          </button>
        ))
      }
    </div>
    <p class="filter-status" role="status">
      <span class="filter-visible">{posts.length}</span> / {posts.length} 篇显示中
    </p>
    <PostList posts={posts} headingLevel="h2" filterable splitSubstance thinLabel="短记录" />
    <p class="no-results" hidden>这个分类里暂时还没有文章。</p>
  </section>
  <div class="container archive-link">
    <a class="text-link" href="/archive/">切换到年份归档</a>
  </div>
  <Fragment slot="scripts">
    <script>
      const buttons = [
        ...document.querySelectorAll<HTMLButtonElement>('.filter-bar button'),
      ];
      const items = [
        ...document.querySelectorAll<HTMLElement>('.grid-item, .rows li'),
      ];
      const empty = document.querySelector<HTMLElement>('.no-results');
      const counter = document.querySelector<HTMLElement>('.filter-visible');
      const thinGroup = document.querySelector<HTMLElement>('.list-thin');

      function apply(category: string) {
        let visible = 0;
        for (const item of items) {
          const show = category === '全部' || item.dataset.category === category;
          item.hidden = !show;
          if (show) visible += 1;
        }
        // 短记录分组整体隐藏 —— 否则会留下一个空标题和一条孤零零的分隔线
        if (thinGroup) {
          thinGroup.hidden = ![...thinGroup.querySelectorAll('li')].some(
            (li) => !li.hidden,
          );
        }
        if (counter) counter.textContent = String(visible);
        if (empty) empty.hidden = visible > 0;
      }

      for (const button of buttons) {
        button.addEventListener('click', () => {
          for (const other of buttons) {
            const active = other === button;
            other.classList.toggle('active', active);
            other.setAttribute('aria-pressed', String(active));
          }
          apply(button.dataset.category ?? '全部');
        });
      }
    </script>
  </Fragment>
</Layout>
<style>
  .blog-section {
    padding-bottom: 40px;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .filter-bar button {
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    font-family: var(--font-sans);
  }
  .filter-bar button:hover,
  .filter-bar button.active {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--on-signal);
  }
  .filter-status {
    margin: 0 0 26px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .archive-link {
    padding: 20px 0 100px;
    text-align: right;
  }
  .no-results {
    padding: 60px;
    color: var(--ink-soft);
    text-align: center;
  }
</style>
