---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';
import SeeAlso from '../../components/SeeAlso.astro';
import { byNewest, formatDate, normalizeCategory, normalizeTags, postHref, readingMinutes } from '../../utils/posts';
import { buildRelations, getRelated } from '../../utils/relations';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.(md|mdx)$/i, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byNewest);
const index = allPosts.findIndex((item) => item.id === post.id);
const newer = index > 0 ? allPosts[index - 1] : undefined;
const older = index < allPosts.length - 1 ? allPosts[index + 1] : undefined;
const tags = normalizeTags(post.data.tags);

// 「参见」与主题总览同源（utils/relations.ts），因此不会互相矛盾。
// 只列真实共享标签的文章，不显示无法核对的相关度数字。
const related = getRelated(post, buildRelations(allPosts), 4);
---
<Layout title={post.data.title} description={post.data.description} image={post.data.image || '/images/banner.jpg'} article>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <article data-pagefind-body>
    <header class="article-header container">
      <a class="back-link" href="/blog/">← 返回文章</a>
      <div class="article-meta"><span>{normalizeCategory(post.data.category)}</span><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time><span>{readingMinutes(post)} 分钟阅读</span></div>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      {post.data.description && <p class="article-description" data-pagefind-meta="description">{post.data.description}</p>}
      <ul class="tag-list">{tags.map((tag) => <li><a class="tag" href={`/tags/${encodeURIComponent(tag)}/`} data-pagefind-filter={`tag:${tag}`}>{tag}</a></li>)}</ul>
    </header>
    <div class="article-layout container">
      <aside class="toc" aria-label="文章目录"><p>本页目录</p><nav>{headings.filter((heading) => heading.depth <= 3).map((heading) => <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>
      <div class="article-main"><div class="prose"><Content /></div>
        {related.length > 0 && <SeeAlso relations={related} label="参见 —— 讲过同一件事的记录" />}

        <div class="article-license"><span>CC</span><p>除特别注明外，本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noreferrer">CC BY-NC-SA 4.0</a> 协议。</p></div>
        <nav class="post-nav" aria-label="相邻文章">{older ? <a href={postHref(older)}><span>上一篇</span><strong>{older.data.title}</strong></a> : <span></span>}{newer && <a class="next" href={postHref(newer)}><span>下一篇</span><strong>{newer.data.title}</strong></a>}</nav>
        <Comments />
      </div>
    </div>
  </article>
  <Fragment slot="scripts">
    <script>
      // 横向可滚动的公式块必须能用键盘滚 —— 只有鼠标能滚等于对键盘用户不可用
      // （axe 的 scrollable-region-focusable）。
      //
      // 但**只给真正溢出的块加 tabindex**：transformer 一篇有 496 个公式块，
      // 全加上就是 496 个 Tab 停靠点，那比原问题更糟 —— 键盘用户要按 496 次
      // Tab 才能走到下一个真正的内容链接。是否溢出取决于栏宽，所以
      // 布局完成、字体加载完成、以及窗口尺寸变化时都要重算。
      const markScrollableMath = () => {
        for (const el of document.querySelectorAll('.prose .katex-display')) {
          const overflows = el.scrollWidth > el.clientWidth + 1;
          const marked = el.hasAttribute('tabindex');
          if (overflows && !marked) {
            el.setAttribute('tabindex', '0');
            // 用 group 而不是 region：region 在 ARIA 里是**地标**，
            // 一篇里 4 个同名地标会被 axe 判为 landmark-unique 违规，
            // 对屏幕阅读器用户也确实是歧义（"区域"列表里 4 个一模一样）。
            // 公式是局部内容，本就不该是页面地标。
            el.setAttribute('role', 'group');
            el.setAttribute('aria-label', '数学公式，可横向滚动');
          } else if (!overflows && marked) {
            el.removeAttribute('tabindex');
            el.removeAttribute('role');
            el.removeAttribute('aria-label');
          }
        }
      };

      let pending = false;
      const scheduleMark = () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
          pending = false;
          markScrollableMath();
        });
      };

      markScrollableMath();
      // KaTeX 的字体是异步加载的，字体到位后宽度会变
      document.fonts?.ready.then(markScrollableMath);
      addEventListener('resize', scheduleMark);
      addEventListener('load', markScrollableMath);
    </script>
    <script>
      const bar=document.querySelector<HTMLElement>('.reading-progress span');
      const update=()=>{const max=document.documentElement.scrollHeight-innerHeight;const value=max>0?scrollY/max*100:0;if(bar)bar.style.width=`${Math.min(100,value)}%`};addEventListener('scroll',update,{passive:true});update();
    </script>
  </Fragment>
</Layout>
<style>
  .reading-progress{position:fixed;top:0;right:0;left:0;z-index:50;height:3px}.reading-progress span{display:block;width:0;height:100%;background:linear-gradient(90deg,var(--signal-text),var(--accent-text))}.article-header{padding:clamp(70px,10vw,130px) 0 clamp(58px,8vw,94px);border-bottom:1px solid var(--line)}.back-link{display:inline-block;margin-bottom:48px;color:var(--ink-soft);font-size:13px;text-decoration:none}.back-link:hover{color:var(--accent-text)}.article-meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin-bottom:24px;color: var(--ink-soft);font-family:var(--font-mono);font-size:11px;letter-spacing:.04em}.article-header h1{max-width:1000px;margin:0;font-family:var(--font-display);font-size:clamp(28px,4vw,44px);font-weight:520;letter-spacing:-.045em;line-height:1.08}.article-description{max-width:740px;margin:28px 0 26px;color:var(--ink-soft);font-size:clamp(18px,2vw,22px)}.article-layout{display:grid;grid-template-columns:190px minmax(0,var(--reading));justify-content:center;gap:70px;padding-top:76px;padding-bottom:110px}.toc{position:sticky;top:32px;align-self:start;max-height:calc(100vh - 64px);overflow:auto}.toc>p{margin:0 0 14px;color: var(--ink-soft);font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.toc nav{display:flex;flex-direction:column;gap:8px}.toc a{color: var(--ink-soft);font-size:12px;line-height:1.45;text-decoration:none}.toc a:hover{color:var(--accent-text)}.toc .depth-3{padding-left:12px}.article-main{min-width:0}.article-main :global(.see-also){margin-top:64px;padding-top:28px;border-top:1px solid var(--line)}.article-license{display:flex;align-items:center;gap:16px;margin-top:64px;padding:20px;border:1px solid var(--line);border-radius:var(--radius);color:var(--ink-soft);font-size:13px}.article-license>span{width:40px;height:40px;display:grid;place-items:center;flex:0 0 auto;border-radius:var(--radius-sm);background:var(--surface);color:var(--accent-text);font-weight:800}.article-license p{margin:0}.article-license a{color:var(--ink)}.post-nav{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}.post-nav a{display:flex;min-height:130px;flex-direction:column;padding:20px;border:1px solid var(--line);border-radius:var(--radius);text-decoration:none}.post-nav a:hover{border-color:var(--accent-text)}.post-nav span{color: var(--ink-soft);font-size:11px}.post-nav strong{margin-top:10px;font-family:var(--font-display);font-size:18px;line-height:1.4}.post-nav .next{text-align:right}@media(max-width:900px){.article-layout{grid-template-columns:minmax(0,var(--reading))}.toc{display:none}}@media(max-width:640px){.article-header{width:calc(100% - var(--gutter-mobile) * 2)}.article-layout{width:calc(100% - var(--gutter-mobile) * 2)}.post-nav{grid-template-columns:1fr}.post-nav>span:empty{display:none}}
</style>
