---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getAllPosts, getAllTags, getByTag } from '../../utils/posts-query';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return getAllTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: getByTag(posts, tag) },
  }));
}

const { tag, posts } = Astro.props;
---
<Layout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章。`}>
  <header class="page-hero container">
    <p class="eyebrow">标签 · {posts.length} 篇</p>
    <h1 class="page-title">#{tag}</h1>
    <p class="lede">同一个关键词连接起来的文章。</p>
  </header>
  <!-- 标签页是完整枚举，不做降权：读者点进来就是要看全部。 -->
  <section class="container tag-posts">
    <PostList posts={posts} headingLevel="h2" emptyText="这个标签下暂时还没有文章。" />
  </section>
</Layout>
<style>
  .tag-posts {
    padding-bottom: 120px;
  }
</style>
