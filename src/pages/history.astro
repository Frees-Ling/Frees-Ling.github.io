---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { byNewest, formatDate, postHref } from '../utils/posts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byNewest);
const firstPost = posts.at(-1);
const lastPost = posts.at(0);
---

<Layout
  title="网站历史博物馆"
  description="进入 Frees Blog 的历代网站，在可交互的网页展柜中重新浏览旧版设计。"
>
  <header class="page-hero container history-hero">
    <p class="eyebrow">FREES BLOG · WEB MUSEUM</p>
    <h1 class="page-title">网站历史<br />博物馆</h1>
    <div class="hero-bottom">
      <p class="lede">每一版都保留当时的文字、界面和交互。点击展柜即可进入完整旧站。</p>
      <dl class="history-stats">
        <div><dt>网站版本</dt><dd>02</dd></div>
        <div><dt>保留文章</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div>
        <div><dt>记录跨度</dt><dd>{firstPost?.data.published.getFullYear() ?? '—'}—{lastPost?.data.published.getFullYear() ?? '—'}</dd></div>
      </dl>
    </div>
  </header>

  <section class="container museum" aria-labelledby="museum-title">
    <div class="section-header">
      <div><p class="eyebrow">LIVE EXHIBITS</p><h2 id="museum-title" class="section-title">可浏览的旧站</h2></div>
      <p>展柜里运行的是历史页面本身，不是截图。可以滚动、点击并进入完整版本。</p>
    </div>

    <div class="exhibits">
      <article class="exhibit">
        <header class="exhibit-head">
          <div><span class="version">VERSION 01</span><h3>Web of FL</h3></div>
          <p>第一版 · 原生 HTML / CSS / JavaScript</p>
        </header>
        <div class="browser-frame">
          <div class="browser-bar" aria-hidden="true">
            <span></span><span></span><span></span><p>frees-ling.dev/history/v1/</p>
          </div>
          <iframe
            src="/history/v1/index.html"
            title="第一版 Web of FL 可交互预览"
            sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
            loading="eager"
          ></iframe>
        </div>
        <footer class="exhibit-foot">
          <p>保留早期自我介绍、按钮交互与最初的网站表达。缺失的外部样式仅补充了浏览兼容处理。</p>
          <a class="button primary" href="/history/v1/index.html" target="_blank">进入第一版</a>
        </footer>
      </article>

      <article class="exhibit">
        <header class="exhibit-head">
          <div><span class="version">VERSION 02</span><h3>Frees Ling · Blog</h3></div>
          <p>第二版 · Astro 内容博客</p>
        </header>
        <div class="browser-frame">
          <div class="browser-bar" aria-hidden="true">
            <span></span><span></span><span></span><p>frees-ling.dev/history/v2/</p>
          </div>
          <iframe
            src="/history/v2/index.html"
            title="第二版 Frees Ling Blog 可交互预览"
            sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
            loading="lazy"
          ></iframe>
        </div>
        <footer class="exhibit-foot">
          <p>完整保留旧主题、分页、归档、文章页、关于页和朋友页，并为博物馆路径重新生成静态版本。</p>
          <div class="exhibit-actions">
            <a class="button primary" href="/history/v2/index.html" target="_blank">进入第二版</a>
            <a
              class="button"
              href="https://github.com/Frees-Ling/Frees-Ling.github.io/tree/main/archives/sites/Frees-Blog"
              target="_blank"
              rel="noreferrer"
            >查看历史源码</a>
          </div>
        </footer>
      </article>
    </div>
  </section>

  <section id="legacy-timeline" class="container timeline-section">
    <div class="section-header">
      <div><p class="eyebrow">ARCHIVED WRITING</p><h2 class="section-title">历史文章</h2></div>
      <p>旧站文章继续由现在的 Frees Blog 保存和阅读。</p>
    </div>
    <ol class="timeline">
      {posts.map((post, index) => (
        <li>
          <span class="timeline-index">{String(posts.length - index).padStart(2, '0')}</span>
          <a href={postHref(post)}>
            <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
            <strong>{post.data.title}</strong>
            <span class="timeline-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  .history-hero { padding-bottom: 72px; }
  .hero-bottom { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 48px; align-items: end; margin-top: 30px; }
  .hero-bottom .lede { margin: 0; }
  .history-stats { display: grid; grid-template-columns: repeat(3,auto); gap: clamp(24px,4vw,56px); margin: 0; }
  .history-stats dt { color: var(--ink-faint); font-family: ui-monospace,monospace; font-size: 12px; letter-spacing: .08em; }
  .history-stats dd { margin: 4px 0 0; font-family: Georgia,serif; font-size: 24px; white-space: nowrap; }
  .museum { padding: 24px 0 clamp(88px,11vw,140px); }
  .exhibits { display: grid; gap: clamp(64px,9vw,110px); }
  .exhibit { overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(8,31,38,.7); box-shadow: var(--shadow); }
  .exhibit-head,.exhibit-foot { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: clamp(22px,3vw,34px); }
  .exhibit-head { border-bottom: 1px solid var(--line); }
  .exhibit-head h3 { margin: 5px 0 0; font-family: Georgia,"Songti SC",serif; font-size: clamp(28px,4vw,46px); font-weight: 500; letter-spacing: -.035em; }
  .exhibit-head > p,.exhibit-foot > p { max-width: 520px; margin: 0; color: var(--ink-soft); }
  .version { color: var(--coral); font-family: ui-monospace,monospace; font-size: 12px; font-weight: 700; letter-spacing: .14em; }
  .browser-frame { margin: clamp(16px,2vw,28px); overflow: hidden; border: 1px solid var(--line-strong); border-radius: 16px; background: #fff; }
  .browser-bar { display: grid; grid-template-columns: 10px 10px 10px minmax(0,1fr); gap: 7px; align-items: center; height: 42px; padding: 0 15px; border-bottom: 1px solid #d6d9db; background: #edf0f1; }
  .browser-bar > span { width: 10px; height: 10px; border-radius: 50%; background: #ff6d62; }
  .browser-bar > span:nth-child(2) { background: #f7bf45; }
  .browser-bar > span:nth-child(3) { background: #5acb6b; }
  .browser-bar p { width: min(100%,520px); margin: 0 auto; padding: 4px 12px; overflow: hidden; border: 1px solid #d8dcde; border-radius: 6px; color: #657176; background: #fff; font: 12px/1.3 ui-monospace,monospace; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
  iframe { display: block; width: 100%; height: min(62vw,620px); min-height: 430px; border: 0; background: #fff; }
  .exhibit-foot { align-items: center; border-top: 1px solid var(--line); }
  .exhibit-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; }
  .timeline-section { padding-bottom: clamp(88px,11vw,140px); }
  .timeline { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .timeline li { display: grid; grid-template-columns: 72px 1fr; align-items: stretch; border-bottom: 1px solid var(--line); }
  .timeline-index { display: grid; place-items: center; color: var(--ink-faint); font-family: ui-monospace,monospace; font-size: 12px; border-right: 1px solid var(--line); }
  .timeline a { display: grid; grid-template-columns: 170px minmax(0,1fr) 28px; gap: 22px; align-items: center; padding: 23px 0 23px 28px; text-decoration: none; }
  .timeline time { color: var(--ink-faint); font-family: ui-monospace,monospace; font-size: 12px; }
  .timeline strong { font-family: Georgia,"Songti SC",serif; font-size: clamp(18px,2.2vw,24px); font-weight: 500; transition: color 180ms ease; }
  .timeline-arrow { color: var(--coral); transition: transform 180ms ease; }
  .timeline a:hover strong { color: var(--cyan); }
  .timeline a:hover .timeline-arrow { transform: translate(3px,-3px); }
  @media (max-width: 820px) { .hero-bottom { grid-template-columns: 1fr; } .history-stats { grid-template-columns: repeat(3,1fr); } .exhibit-head,.exhibit-foot { align-items: flex-start; flex-direction: column; } .exhibit-actions { justify-content: flex-start; } }
  @media (max-width: 640px) { .history-stats { grid-template-columns: 1fr 1fr; } .history-stats div:last-child { grid-column: 1/-1; } .browser-frame { margin: 10px; border-radius: 10px; } .browser-bar p { text-align: left; } iframe { min-height: 500px; } .timeline li { grid-template-columns: 46px 1fr; } .timeline a { grid-template-columns: 1fr 22px; gap: 7px 14px; padding-left: 18px; } .timeline time { grid-column: 1/-1; } }
</style>
