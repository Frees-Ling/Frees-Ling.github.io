---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/primitives.css';
import '../styles/prose.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title,
  description = site.description,
  image = '/images/banner.jpg',
  article = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.description}`;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- theme-color 用 media 作用域成对声明：零 JS，且随系统主题自动切换。
         原先是硬编码的单个 #071c24，既不符合任何 token，也不会随主题更新，
         导致浅色模式下移动端浏览器 UI 仍是深色。 -->
    <meta
      name="theme-color"
      content="#06171d"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ebe6d9"
      media="(prefers-color-scheme: light)"
    />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('frees-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <!-- 页面级 head 注入点。没有它时，页面只能把 <link>/<script> 写在 </Layout>
         之后，Astro 会把它们渲染到 </html> 之外，产生无效 HTML
         （/search/ 页实测有 858 字符内容落在 </html> 之后）。 -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-shell">
      <Header />
      <main id="main-content"><slot /></main>
      <Footer />
    </div>
    <script is:inline async src="https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js"></script>
    <!-- 页面级 body 末尾脚本注入点 -->
    <slot name="scripts" />
  </body>
</html>
