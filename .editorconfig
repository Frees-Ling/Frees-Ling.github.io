# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 中行尾两个空格是合法的硬换行，交由 markdownlint 判定
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2
